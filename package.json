{
  "name": "routecast",
  "private": true,
  "description": "Compara rutas en coche según el tiempo que hará en cada tramo cuando pases tú.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @routecast/web --filter @routecast/worker dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @routecast/web test:e2e",
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "size": "size-limit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@size-limit/file": "14.2.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "size-limit": "14.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
