[
  {
    "name": "web: JS inicial (gzip; sin mapa ni galería)",
    "path": [
      "apps/web/dist/assets/*.js",
      "!apps/web/dist/assets/gallery-*.js",
      "!apps/web/dist/assets/maplibre-gl-*.js"
    ],
    "limit": "120 KB",
    "gzip": true
  },
  {
    "name": "web: mapa diferido (MapLibre + worker, gzip)",
    "path": "apps/web/dist/assets/maplibre-gl-*.js",
    "limit": "300 KB",
    "gzip": true
  },
  {
    "name": "web: worker de MapLibre (gzip)",
    "path": "apps/web/dist/assets/maplibre-gl-worker-*.mjs",
    "limit": "160 KB",
    "gzip": true
  },
  {
    "name": "web: CSS de la app (gzip)",
    "path": ["apps/web/dist/assets/*.css", "!apps/web/dist/assets/gallery-*.css"],
    "limit": "40 KB",
    "gzip": true
  }
]
